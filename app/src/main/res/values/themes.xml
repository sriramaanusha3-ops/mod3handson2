<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NeuralSearch" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary brand colors -->
        <item name="colorPrimary">@color/electric_purple</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSecondary">@color/cyan_accent</item>
        <item name="colorOnSecondary">@color/bg_primary</item>

        <!-- Status bar and window backgrounds -->
        <item name="android:statusBarColor">@color/bg_primary</item>
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:navigationBarColor">@color/bg_secondary</item>

        <!-- Material components styling -->
        <item name="materialCardViewStyle">@style/Widget.GlassCard</item>
    </style>

    <style name="Widget.GlassCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">4dp</item>
        <item name="strokeColor">@color/border_color</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>
